# Template only. Copy to .env (local) and put real values there; add the same in Vercel → Settings → Environment Variables.
# Never put real keys in this file: it is committed to GitHub.

# --- Supabase (required): database, authentication, file storage ---
# Supabase dashboard → Project Settings → API. The URL looks like https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Password for the shared demo student account (optional; a default is used if empty)
DEMO_PASSWORD=

# --- AI (optional, pick one; the app has offline fallbacks) ---
# Claude: https://console.anthropic.com → Settings → API Keys
ANTHROPIC_API_KEY=
# Gemini (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3-flash-preview

# Real SMS for OTP is configured inside Supabase (Authentication → Sign In / Providers → Phone → Twilio Verify), not here.
