# Copy this file to .env. Everything is optional: without keys the app runs in demo mode.

# --- AI (pick one) ---
# Claude (best quality) — https://console.anthropic.com → Settings → API Keys (needs a few $ of credits)
ANTHROPIC_API_KEY=
# Gemini (free tier) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3-flash-preview

# --- Real SMS OTP (optional) ---
# Without these, OTPs are shown on screen in "demo mode".
# Twilio Verify — https://console.twilio.com → Verify → Services → Create (copy the Service SID "VA…")
# Trial accounts can only text numbers you've verified in the Twilio console.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Secret used to sign OTP codes in demo mode (any random string)
OTP_SECRET=
